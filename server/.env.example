# Copy this file to ".env" and fill in your values.

# ── Phone app (python app.py) ──
# Password you type once on your phone to unlock the app. Pick something only you know.
APP_PASSWORD=change-me
PORT=8000

# ── Telegram bot (python second_brain_bot.py), optional ──
# From @BotFather on Telegram
TELEGRAM_TOKEN=123456789:ABCdefYourBotTokenHere

# From https://console.anthropic.com  (API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Leave as 0 at first. Message your bot once, it will tell you your ID. Then paste it here and restart.
OWNER_ID=0

YOUR_NAME=Asif Ahmed

# Your timezone (IANA name), e.g. Asia/Kolkata, Asia/Dhaka, Europe/London, America/New_York
TIMEZONE=Asia/Dhaka

# Daily morning briefing and Sunday weekly review times (24h, local)
BRIEFING_TIME=07:30
REVIEW_TIME=19:00

# Voice for spoken replies. Some options:
#   en-US-AriaNeural, en-GB-SoniaNeural, en-IN-NeerjaNeural, en-IN-PrabhatNeural,
#   hi-IN-SwaraNeural (Hindi), bn-BD-NabanitaNeural (Bangla), ta-IN-PallaviNeural (Tamil)
TTS_VOICE=en-US-AriaNeural

# Symbol shown before expense amounts, e.g. ₹ or $ or ৳
CURRENCY=৳

# Haiku = cheapest and fastest. Switch to claude-sonnet-5-5 for smarter answers.
CLAUDE_MODEL=claude-haiku-5-5
